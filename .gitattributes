# Normalise line endings for a repository that is edited on multiple platforms.
* text=auto eol=lf

# Shell scripts must keep LF, a CRLF shebang breaks the test harness.
*.sh text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.md text eol=lf

# Keep the GPL text byte-exact.
LICENSE -text

# Rendered/captured assets, if any are ever added.
*.png binary
*.jpg binary
*.webp binary
*.zip binary
